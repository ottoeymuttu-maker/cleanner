# คัดลอกไฟล์นี้เป็น .env.local แล้วกรอกค่าจริง (ห้าม commit .env.local)

# ใช้เซ็น cookie การ login (บนเว็บจริงต้องตั้ง เป็นข้อความสุ่มยาว ๆ)
SESSION_SECRET=

# ---------- Firebase / Firestore (ฝั่ง server) ----------
# Firebase Console → Project settings → Service accounts → Generate new private key
# ถ้าไม่ตั้งค่าทั้งสองแบบ ระบบจะใช้ไฟล์ data/db.json แทน
#
# แบบที่ 1 (บนเครื่อง): วางไฟล์ JSON ไว้ในโฟลเดอร์ .secrets/ แล้วชี้ path
FIREBASE_SERVICE_ACCOUNT_FILE=
#
# แบบที่ 2 (บนโฮสต์ เช่น Vercel): คัดลอก 3 ค่าจากไฟล์ JSON มาใส่
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# ใส่ทั้งก้อนในเครื่องหมายคำพูด รวม -----BEGIN PRIVATE KEY----- ... \n ...
FIREBASE_PRIVATE_KEY=""

# Firebase Storage สำหรับรูปงาน (ดูชื่อ bucket ได้ที่ Console → Storage เช่น cleannerproject.firebasestorage.app)
# เว้นว่าง = เก็บรูปไว้ที่ data/uploads บนเครื่อง
FIREBASE_STORAGE_BUCKET=

# ---------- LINE (ยังไม่ต้องใส่ตอนนี้) ----------
LINE_OA_BASIC_ID=
LINE_MESSAGING_CHANNEL_ID=
# ใช้ตรวจ ID token จาก LIFF
LINE_LOGIN_CHANNEL_ID=
LIFF_ID_CUSTOMER=
LIFF_ID_STAFF=
# LINE userId ของแอดมิน คั่นด้วย ,
ADMIN_LINE_USER_IDS=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
